{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker images in Ansible inventory vars ending in _image",
      "managerFilePatterns": [
        "/(^|/)(group_vars|host_vars)/.+$/",
        "/(^|/)inventory/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "_image:[ \\t]*[\"']?(?<depName>[^\\s\"'@]+?):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?[ \\t]*(?:\\n|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}



{
  "packageRules": [
    {
      "description": "Checkmk tags like 2.6.0-2026.06.10",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/check-mk-/"],
      "versioning": "regex:^(?<compatibility>\\d+\\.\\d+\\.\\d+)-(?<major>\\d{4})[.-](?<minor>\\d{2})[.-](?<patch>\\d{2})$"
    }
  ]
}


npx --yes --package renovate -- renovate-config-validator
LOG_LEVEL=debug npx --yes renovate --platform=local > renovate.log 2>&1
export RENOVATE_HOST_RULES='[{"matchHost":"registry.checkmk.com","hostType":"docker","username":"you","password":"secret"}]'
grep -n "check-mk" renovate.log
